    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Lock_Or_Unlock</targetReference>
        </connector>
        <filterFormula>AND(
    ISCHANGED({!$Record.Status}),
    OR(
        /* 1a. Status changed to Approved */
        ISPICKVAL({!$Record.Status}, &apos;Approved&apos;),

        /* 1b. Status changed to Rejected, only from Approved or In Review */
        AND(
            ISPICKVAL({!$Record.Status}, &apos;Rejected&apos;),
            ISPICKVAL(PRIORVALUE({!$Record.Status}), &apos;In Review&apos;)

        ),

        /* 2. Status moved back from a later stage to an early stage */
        AND(
            OR(
                ISPICKVAL(PRIORVALUE({!$Record.Status}), &apos;Approved&apos;),
                ISPICKVAL(PRIORVALUE({!$Record.Status}), &apos;Rejected&apos;),
                ISPICKVAL(PRIORVALUE({!$Record.Status}), &apos;Presented&apos;),
                ISPICKVAL(PRIORVALUE({!$Record.Status}), &apos;Accepted&apos;),
                ISPICKVAL(PRIORVALUE({!$Record.Status}), &apos;Denied&apos;)
            ),
            OR(
                ISPICKVAL({!$Record.Status}, &apos;Draft&apos;),
                ISPICKVAL({!$Record.Status}, &apos;Needs Review&apos;),
                ISPICKVAL({!$Record.Status}, &apos;In Review&apos;)
            )
        )
    )
)</filterFormula>
        <object>Quote</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
